{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all APIs",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "DeliveryPlatform.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Identity",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "Services/Identity.API",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5001"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
